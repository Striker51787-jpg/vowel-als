{
  "$note": "Voice Check design system v1. Units are points (pt) for React Native. Colors are hex.",
  "color": {
    "light": {
      "bg": "#F8F4EC",
      "surface": "#FFFFFF",
      "border": "#DDD5C6",
      "text": "#1F2D3A",
      "textSecondary": "#3E4B58",
      "primary": "#2B5F75",
      "onPrimary": "#FFFFFF",
      "primaryText": "#1F4C60",
      "soft": "#E6EFF2",
      "focus": "#1F2D3A",
      "ring": "#D6E5EA",
      "track": "#DDD5C6",
      "noise": "#9AA3AB",
      "band": {
        "low": {
          "bg": "#D3E6EE",
          "ink": "#1F2D3A"
        },
        "borderline": {
          "bg": "#E9BC62",
          "ink": "#1F2D3A"
        },
        "elevated": {
          "bg": "#5A3D6E",
          "ink": "#FFFFFF"
        }
      }
    },
    "dark": {
      "bg": "#141B21",
      "surface": "#1E2830",
      "border": "#3A4853",
      "text": "#F1EEE8",
      "textSecondary": "#BDC7CF",
      "primary": "#8CC2D6",
      "onPrimary": "#0E2530",
      "primaryText": "#A9D4E3",
      "soft": "#26404C",
      "focus": "#F1EEE8",
      "ring": "#2E4A58",
      "track": "#3A4853",
      "noise": "#7A8791",
      "band": {
        "low": {
          "bg": "#3A6477",
          "ink": "#FFFFFF"
        },
        "borderline": {
          "bg": "#E3B75F",
          "ink": "#1A1405"
        },
        "elevated": {
          "bg": "#CDB4E0",
          "ink": "#1E1428"
        }
      }
    }
  },
  "font": {
    "display": {
      "family": "Fraunces",
      "weights": [
        500,
        600
      ],
      "rnNames": {
        "500": "Fraunces_500Medium",
        "600": "Fraunces_600SemiBold"
      }
    },
    "body": {
      "family": "Atkinson Hyperlegible",
      "weights": [
        400,
        700
      ],
      "rnNames": {
        "400": "AtkinsonHyperlegible_400Regular",
        "700": "AtkinsonHyperlegible_700Bold"
      }
    },
    "note": "Both are SIL Open Font License, free on Google Fonts. Support Dynamic Type; nothing below 17pt."
  },
  "type": {
    "display": {
      "font": "display",
      "size": 42,
      "lineHeight": 48,
      "weight": 500,
      "use": "welcome and result headlines"
    },
    "title": {
      "font": "display",
      "size": 34,
      "lineHeight": 40,
      "weight": 500,
      "use": "screen titles, coach titles"
    },
    "prompt": {
      "font": "display",
      "size": 28,
      "lineHeight": 34,
      "weight": 500,
      "use": "task prompt"
    },
    "button": {
      "font": "body",
      "size": 22,
      "lineHeight": 28,
      "weight": 700
    },
    "bodyLarge": {
      "font": "body",
      "size": 21,
      "lineHeight": 30,
      "weight": 400
    },
    "body": {
      "font": "body",
      "size": 19,
      "lineHeight": 28,
      "weight": 400
    },
    "caption": {
      "font": "body",
      "size": 17,
      "lineHeight": 24,
      "weight": 400,
      "note": "smallest size allowed"
    }
  },
  "typeExtended": {
    "_note": "Sizes used on the recording screens that go beyond the base scale",
    "soundWord": {
      "font": "display",
      "size": 56,
      "lineHeight": 60,
      "weight": 500,
      "use": "instruction: eeee / pa-pa-pa"
    },
    "soundWordSmall": {
      "font": "display",
      "size": 40,
      "lineHeight": 44,
      "weight": 500,
      "use": "recording screen sound word"
    },
    "countdownNumber": {
      "font": "display",
      "size": 104,
      "lineHeight": 110,
      "weight": 500
    },
    "timer": {
      "font": "body",
      "size": 44,
      "lineHeight": 48,
      "weight": 700,
      "fontVariant": [
        "tabular-nums"
      ]
    },
    "cue": {
      "font": "body",
      "size": 21,
      "weight": 700
    },
    "headerLabel": {
      "font": "body",
      "size": 20,
      "weight": 700,
      "use": "Exit, Task 3 of 8, text buttons"
    },
    "kicker": {
      "font": "body",
      "size": 18,
      "weight": 700
    }
  },
  "spacing": {
    "xs": 4,
    "s": 8,
    "m": 12,
    "l": 16,
    "xl": 24,
    "2xl": 32,
    "3xl": 48
  },
  "layout": {
    "screenPaddingH": 24,
    "screenPaddingTop": "safe area top (59 on the design frame)",
    "screenPaddingBottom": "safe area bottom (34 on the design frame)"
  },
  "radius": {
    "small": 14,
    "field": 16,
    "button": 20,
    "card": 24,
    "round": 9999,
    "segment": 5
  },
  "size": {
    "minTouch": 48,
    "buttonHeight": 64,
    "fieldHeight": 60,
    "checkbox": 28,
    "recordButton": 136,
    "recordButtonBorder": 8,
    "recordHalo": 184,
    "countdownRing": 252,
    "countdownTick": {
      "count": 60,
      "width": 4,
      "height": 18,
      "radius": 2
    },
    "waveform": {
      "bars": 27,
      "barWidth": 7,
      "gap": 5,
      "stageHeight": 190,
      "minBarHeight": 8,
      "maxExtra": 160
    },
    "coachIllustration": {
      "bars": 30,
      "barWidth": 6,
      "gap": 4,
      "rowHeight": 56
    },
    "progressSegment": {
      "count": 8,
      "height": 10,
      "gap": 6,
      "border": 2
    },
    "border": 1,
    "focusRing": 3,
    "auth": {
      "inputBorder": 2,
      "inputBorderFocused": 3,
      "inputRadius": 16,
      "inputPaddingH": 18,
      "passwordRightPadding": 84,
      "showButtonMinWidth": 64,
      "label": {
        "size": 19,
        "weight": 700
      },
      "helper": {
        "size": 17
      },
      "checkbox": {
        "box": 28,
        "radius": 8,
        "uncheckedBorder": 3,
        "check": {
          "width": 15,
          "height": 8,
          "border": 3,
          "rotateDeg": -45
        }
      },
      "errorBox": {
        "border": 2,
        "borderColor": "primaryText",
        "radius": 18,
        "paddingV": 14,
        "paddingH": 16,
        "text": 19,
        "role": "alert"
      },
      "softNote": {
        "radius": 18,
        "paddingV": 14,
        "paddingH": 16,
        "background": "soft"
      },
      "consentCard": {
        "radius": 20,
        "paddingV": 14,
        "paddingH": 16,
        "border": 1,
        "gap": 10
      },
      "consentBox": {
        "radius": 20,
        "padding": 16,
        "background": "soft"
      },
      "logoMark": {
        "diameter": 48,
        "barWidth": 4,
        "barHeights": [
          10,
          22,
          30,
          18,
          8
        ],
        "gap": 3
      },
      "sentCircle": {
        "diameter": 112,
        "check": {
          "width": 40,
          "height": 22,
          "border": 6,
          "rotateDeg": -45
        }
      },
      "welcomeWaveform": {
        "bars": 27,
        "stageHeight": 120,
        "minBarHeight": 8,
        "maxExtra": 104
      },
      "micIllustration": {
        "halo": 184,
        "inner": 136,
        "pill": {
          "width": 22,
          "height": 40,
          "radius": 11
        }
      },
      "disabledButton": {
        "background": "track",
        "text": "textSecondary"
      }
    }
  },
  "recording": {
    "_note": "Thresholds are placeholders to calibrate on real phones",
    "countdownSeconds": 3,
    "micOpensBeforeGoSeconds": 0.5,
    "autoStopSilenceSeconds": 1.5,
    "hardCapSeconds": 30,
    "tooQuietPeakDbfs": -34,
    "clippedSampleFraction": 0.001,
    "minSpeechOverNoiseDb": 15,
    "tooShortSeconds": 3,
    "vowelAimSeconds": 5,
    "shortTryLimitBeforeOfferingUse": 2
  }
}