# Copy to .env and fill in. Values are read at build/start time (restart `npx expo start` after editing).

# Firebase web app config: Firebase console > Project settings > Your apps > Web app
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Scoring server (api/main.py). Must be reachable from the phone, e.g. http://192.168.1.20:8000
# on the same Wi-Fi, or an https tunnel/host. Leave empty to use the built-in mock scorer.
EXPO_PUBLIC_API_URL=

# Set to 1 to force the mock scorer even when EXPO_PUBLIC_API_URL is set.
EXPO_PUBLIC_MOCK_API=
